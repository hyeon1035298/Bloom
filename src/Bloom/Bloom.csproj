<Project Sdk="Microsoft.NET.Sdk">

  <!-- Bloom: a native (WPF) launcher — apps, files (Everything), calculator, AI chat (Claude Code / Codex CLIs),
       clipboard history, quick searches, screen OCR + translation, timers and reminders, a colour picker, a disk map. No WebView, and
       one NuGet package, Velopack (the setup file and updates from GitHub Releases, App\Updates.cs): Everything is spoken over its
       WM_COPYDATA IPC; searches and links are handed to the browser. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Bloom</AssemblyName>
    <RootNamespace>Bloom</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <Product>Bloom</Product>
    <AssemblyTitle>Bloom</AssemblyTitle>
    <Company>Hyeon</Company>
    <Copyright>Hyeon</Copyright>
    <SatelliteResourceLanguages>ko</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- off: ~4 MB less private memory for a launcher that mostly waits (measured) -->
    <TieredPGO>false</TieredPGO>
    <!-- runtimeconfig.template.json (JSON, no comments): System.GC.Gen0MaxBudget 4 MB caps the gen0 budget, which
         otherwise follows the L3 cache (~48 MB here). Measured: private while in use ~17 MB less on average and
         ~40 MB lower at the peak, same CPU, launcher opening no slower. System.GC.Gen0Size is ignored by .NET 10. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CA1416;SYSLIB1054</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- the emoji / symbol search (tools\make_symbols.py) -->
    <EmbeddedResource Include="Assets\symbols.tsv" LogicalName="Bloom.Assets.symbols.tsv" />
    <!-- the taskbar folders' icon set (tools\folder-icons.py, Ui\FolderIconSet.cs) -->
    <EmbeddedResource Include="Assets\folder-icons.json" LogicalName="Bloom.Assets.folder-icons.json" />
    <!-- Japanese and Chinese, keyed by the English text (tools\lang.py) -->
    <EmbeddedResource Include="Assets\Lang\*.tsv" LogicalName="Bloom.Assets.Lang.%(Filename).tsv" />
    <EmbeddedResource Include="..\..\CHANGELOG.md" LogicalName="Bloom.CHANGELOG.md" />
    <!-- this version's pictures in 바뀐 점 (WhatsNewWindow); the ones of earlier versions stay in docs only -->
    <EmbeddedResource Include="..\..\docs\media\whatsnew\$(Version)\*.webp" LogicalName="Bloom.WhatsNew.%(Filename)%(Extension)" />
    <!-- the add-ons Settings > Add-ons can download, each pinned to its release zip's SHA-256 (Addons\AddonCatalog.cs) -->
    <EmbeddedResource Include="..\..\addons\catalog.json" LogicalName="Bloom.addons.catalog.json" />
    <!-- the OpenAI and Anthropic marks for AI usage accounts (Ai\OfficialLogos.cs); trademarks of their owners, not MIT -->
    <EmbeddedResource Include="Assets\Logos\*.svg" LogicalName="Bloom.Assets.Logos.%(Filename).svg" />
    <!-- tests\Bloom.Tests checks the internal parsers and rankers directly -->
    <InternalsVisibleTo Include="Bloom.Tests" />
    <!-- what Bloom and its elevated Win-key helper (src\WinKeyHelper, issue #3) share: names, tag, task, the tap rule -->
    <Compile Include="..\WinKeyHelper\Shared\*.cs" Link="WinKey\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

</Project>
